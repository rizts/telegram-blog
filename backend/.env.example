# =========================================================================
# BACKEND ENVIRONMENT VARIABLES
# Semua variabel env untuk backend harus disimpan di file 'backend/.env'
# =========================================================================

# Telegram Configuration
BOT_TOKEN=your_bot_token_here
CHANNEL_USERNAME=@your_channel_username

# Neon.tech Database Connection URL
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/telegram_blog?sslmode=require

# Server Port and CORS Settings
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
