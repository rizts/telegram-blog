# =========================================================================
# FRONTEND ENVIRONMENT VARIABLES
# Semua variabel env untuk frontend harus disimpan di file 'frontend/.env'
# =========================================================================

# API URL for Backend Connection
NEXT_PUBLIC_API_URL=http://localhost:3001

# Blog Metadata Customization
NEXT_PUBLIC_BLOG_TITLE="Telegram Channel Blog"
NEXT_PUBLIC_BLOG_DESCRIPTION="A beautiful blog that aggregates and displays public Telegram channel posts."
NEXT_PUBLIC_BLOG_SUBTITLE="Real-time Sync"
