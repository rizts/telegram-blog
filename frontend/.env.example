# =========================================================================
# FRONTEND ENVIRONMENT VARIABLES
# Semua variabel env untuk frontend harus disimpan di file 'frontend/.env'
# =========================================================================

# API URL for Backend Connection
NEXT_PUBLIC_API_URL=http://localhost:3001

# Blog Metadata Customization
NEXT_PUBLIC_BLOG_TITLE="Telegram Channel Blog"
NEXT_PUBLIC_BLOG_DESCRIPTION="A beautiful blog that aggregates and displays public Telegram channel posts."
NEXT_PUBLIC_BLOG_SUBTITLE="Real-time Sync"

# Channel Logo (Optional — URL to an image, e.g. channel profile photo)
NEXT_PUBLIC_BLOG_LOGO_URL=

# Authentication
NEXT_PUBLIC_ADMIN_SECRET=your_admin_secret_here

# Radio App Download Links (Optional)
NEXT_PUBLIC_DOWNLOAD_ANDROID_URL=
NEXT_PUBLIC_DOWNLOAD_IOS_URL=

# Radio Streaming URL (Optional)
NEXT_PUBLIC_RADIO_STREAM_URL=


